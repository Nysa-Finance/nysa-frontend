{
  "name": "nysa-frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/fork.test.js",
    "format": "prettier --write src shared server scripts",
    "test": "NYSA_FEE_BPS=10 node --test --test-reporter=dot 'src/**/*.test.js' 'shared/**/*.test.js' 'server/**/*.test.js' 'scripts/**/*.test.js' vendor/bigint-buffer/test.js",
    "server": "node --env-file-if-exists=.env server/main.js",
    "simulate:swap-fees": "node scripts/simulate-swap-fees.js",
    "setup:loop-fork": "node scripts/setup-loop-fork.js",
    "verify:loop-fork": "node --env-file-if-exists=.env scripts/verify-loop-fork.js"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@kamino-finance/klend-sdk": "^12.0.0",
    "@orca-so/whirlpools-client": "5.0.0",
    "@plausible-analytics/tracker": "^0.4.6",
    "@reown/appkit": "1.8.24",
    "@solana-mobile/wallet-standard-mobile": "^0.6.0",
    "@solana-program/address-lookup-table": "^0.7.0",
    "@solana-program/compute-budget": "^0.8.0",
    "@solana-program/token": "^0.5.1",
    "@solana-program/token-2022": "^0.4.2",
    "@solana/kit": "^2.3.0",
    "@wallet-standard/app": "^1.1.1",
    "@walletconnect/universal-provider": "2.23.7",
    "decimal.js": "^10.6.0",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "3.10.1",
    "vite": "^8.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "toml": "^5.0.1",
    "jayson": "^5.0.0",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "react-native": "file:./vendor/no-react-native",
    "@react-native-async-storage/async-storage": "file:./vendor/no-async-storage",
