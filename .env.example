# Solana RPC for the backend only (never sent to browsers), e.g. https://solana-mainnet.g.alchemy.com/v2/<key>
SOLANA_RPC=
# Jupiter V2 Build API key is optional for prototype/read-only quotes (keyless access: 0.5 requests/second).
# Production traffic needs a configured key and approved provider rate limit.
JUPITER_API_KEY=
# 10-bps native provider fees; each account must be an initialized SPL token account for its named mint.
SWAP_FEE_ACCOUNT_USDC=
SWAP_FEE_ACCOUNT_USDY=
SWAP_FEE_TREASURY_AUTHORITY=
# Production loop enablement requires a named reviewer and an ISO-8601 approval timestamp.
NYSA_LOOP_RISK_OWNER=
NYSA_LOOP_RISK_APPROVED_AT=
# Local-only validator endpoint for `npm run verify:loop-fork`; must be loopback HTTP, never a public RPC.
LOCAL_FORK_RPC=
# The guarded verifier may sign and submit test transactions only to LOCAL_FORK_RPC after the loopback check passes.
# Generate a disposable keypair for the local validator; never reuse a production wallet or commit this secret.
LOCAL_FORK_TEST_WALLET_SECRET_KEY=
LOCAL_FORK_TEST_WALLET=
# Starting balance must be injected into the local fork's test wallet in USDC base units.
LOCAL_FORK_STARTING_USDC_BASE_UNITS=
# Optional test controls: leverage defaults to 1.5; flash borrow type defaults to coll.
LOCAL_FORK_TARGET_LEVERAGE=1.5
LOCAL_FORK_FLASH_BORROW_TYPE=coll
# Fee accounts must be initialized real SPL token accounts owned by this disposable local test authority.
LOCAL_FORK_FEE_ACCOUNT_USDC=
LOCAL_FORK_FEE_ACCOUNT_USDY=
LOCAL_FORK_TREASURY_AUTHORITY=
# --- VPS deploy (docker-compose) ---
# DOMAIN=app.nysa.finance
# TUNNEL_TOKEN=<Cloudflare dashboard: Networks -> Tunnels -> your tunnel -> token>
# PLAUSIBLE_SECRET_KEY_BASE=<openssl rand -base64 48>
# PLAUSIBLE_TOTP_VAULT_KEY=<openssl rand -base64 32>
