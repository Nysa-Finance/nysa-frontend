# Solana RPC for the backend only (never sent to browsers), e.g. https://solana-mainnet.g.alchemy.com/v2/<key>
SOLANA_RPC=
# Used when SOLANA_RPC fails; empty = https://api.mainnet-beta.solana.com (rate-limited)
# SOLANA_RPC_FALLBACK=
